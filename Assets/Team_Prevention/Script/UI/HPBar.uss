:root {
    --bar_height: 90px;
    --bar_hp_height: 80px;
    --bar_hp_width: 500px;
    --bar_radius: 45px;
    --bar_hp_radius: 40px;
}


#hp_bar {
    width: var(--bar_hp_width);
    height: var(--bar_hp_height);
    border-radius: var(--bar_hp_radius);
    background-color: rgb(112, 112, 112);
    opacity: 1;
}

.hp-bar__component {
    position: absolute;
    justify-content: center;
    align-self: center;
    align-items: center;
    align-content: stretch;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0; 
}

.hp-bar__background {
    width: 100%;
    height: 100%;
    position: absolute;
    background-color: black;
    border-radius: var(--bar_hp_radius);
    border-color: skyblue;
    border-width: 5px;
    opacity: 1.0;
}

.hp-bar__fill {
    width: 85%;
    height: 100%;
    position: relative;
    background-color: red;
    padding: 0 var(--bar_hp_radius);
    border-radius: var(--bar_hp_radius);
}

.hp-bar__border {
    width: 100%;
    height: 100%;
    position: absolute;
    padding: 0 var(--bar_hp_radius);
    border-color: skyblue;
    border-width: 5px;
    border-radius: var(--bar_hp_radius);
}


.hp-bar__zero {
    visibility: hidden;
}

.hp-bar__label {
    color: white;
    font-style: bold;
    visibility: visible;
    overflow: visible;
    justify-content: space-evenly;
    align-self: center;
    align-content: stretch;
    position: absolute;
    align-items: stretch;
    -unity-text-align: middle-center;
    text-overflow: clip;
    white-space: pre;
    background-color: rgba(255, 255, 255, 0);
    color: white;
    -unity-font-style: bold;
    font-size: 25px;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}



.hp-bar__component2 {
    border-radius: var(--bar_radius);
    position: absolute;
    justify-content: center;
    border: 5px solid skyblue;
    align-self: center;
    align-items: center;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0; 
}

.hp-bar__component2 > 
.unity-progress-bar__container {
    width: var(--bar_hp_width);
    min-height: var(--bar_hp_height);
    width: var(--bar_hp_width);
    height: var(--bar_hp_height);
    border-radius: var(--bar_radius);
    background-color: rgb(112, 112, 112);
    opacity: 1;
}

/* ”wŒi•”•ª */
.hp-bar__component2 > 
.unity-progress-bar__container>
.unity-progress-bar__background {
    width: 100%;
    height: 100%;
    background-color: black;
    border-radius: var(--bar_radius);
    border-color: skyblue;
    border-width: 5px;
    opacity: 1.0;
}

/* ƒtƒBƒ‹•”•ª */
.hp-bar__component2 >
.unity-progress-bar__container>
.unity-progress-bar__background> 
.unity-progress-bar__progress {
    width: 100%;
    height: 100%;
    background-color: red;
    padding: 0 var(--bar_hp_radius);
    margin:0;
    border-radius: var(--bar_hp_radius);
}

/* ƒ‰ƒxƒ‹•”•ª */
.hp-bar__component2 >
.unity-progress-bar__container >
.unity-progress-bar__background > 
.unity-progress-bar__title-container > 
{
    visibility: visible;
    overflow: visible;
    justify-content: space-evenly;
    align-self: center;
    align-content: stretch;
    position: absolute;
    align-items: stretch;
    -unity-text-align: middle-center;
    text-overflow: clip;
    white-space: pre;
    background-color: rgba(255, 255, 255, 0);
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.hp-bar__component2 >
.unity-progress-bar__container>
.unity-progress-bar__background> 
.unity-progress-bar__title-container > 
.unity-progress-bar__title
{
    font-style: bold;
    visibility: visible;
    overflow: visible;
    justify-content: space-evenly;
    align-self: center;
    align-content: stretch;
    position: absolute;
    align-items: stretch;
    -unity-text-align: middle-center;
    text-overflow: clip;
    white-space: pre;
    background-color: rgba(255, 255, 255, 0);
    color: white;
    -unity-font-style: bold;
    font-size: 25px;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}
